# Database
DATABASE_URL="postgresql://ai_support:ai_support_secret@localhost:5432/ai_customer_support"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# OpenAI (optional - falls back to mock AI if not set)
OPENAI_API_KEY=""

# Gmail support inbox (real email integration)
GMAIL_SUPPORT_EMAIL="berhemit2005@gmail.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/email/gmail/callback"
FRONTEND_URL="http://localhost:5173"
GMAIL_AUTO_SYNC=false
GMAIL_DEMO_ONLY=true
GMAIL_SYNC_INTERVAL_SECONDS=30

# File attachments (PDF, Word, Excel, etc.)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760
MAX_FILES_PER_MESSAGE=5
